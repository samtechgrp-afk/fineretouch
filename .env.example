# Copy to .env for docker compose, or export for local dev.
# Web (apps/web)
NEXT_PUBLIC_AI_URL=http://localhost:8000
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgres://fineretouch:fineretouch@localhost:5432/fineretouch

# Object storage (SeaweedFS locally; AWS S3 or Cloudflare R2 in production)
S3_ENDPOINT=http://localhost:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=fineretouch
S3_ACCESS_KEY=fineretouch
S3_SECRET_KEY=fineretouch-dev-secret

# AI service (services/ai)
CORS_ORIGINS=http://localhost:3000
BLUR_THRESHOLD=40
EYES_CLOSED_THRESHOLD=0.2
WEB_CONCURRENCY=2

# Worker (services/worker)
AI_SERVICE_URL=http://localhost:8000
RENDER_CONCURRENCY=4
