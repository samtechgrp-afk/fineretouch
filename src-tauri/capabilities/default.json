{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions of the FineRetouch editor window. The engine sidecar is started by the Rust core (src/engine.rs); the webview may only run it with --version, to show the engine build in About. File writes go through the shell's own commands (src/files.rs), limited to paths picked in its dialogs.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-set-title",
    "core:window:allow-set-fullscreen",
    "core:window:allow-start-dragging",
    "core:event:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/fineretouch-engine",
          "sidecar": true,
          "args": [
            "--version"
          ]
        }
      ]
    }
  ]
}
